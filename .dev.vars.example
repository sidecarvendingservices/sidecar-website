# Copy this file to .dev.vars (already gitignored) for local `wrangler pages dev`
# testing of the support form's text-message trigger. In production, set these
# same three values as environment variables/secrets in the Cloudflare dashboard:
# Workers & Pages → sidecar-website → Settings → Environment variables.

# OpenPhone/Quo API key — Quo app → Settings → API. Mark as "Secret" in Cloudflare.
QUO_API_KEY=

# The OpenPhone number to send FROM, in E.164 format (e.g. +14708393656).
QUO_FROM_NUMBER=

# Phone number(s) that should receive a text when the support form is
# submitted, in E.164 format. Comma-separate multiple numbers.
SUPPORT_ALERT_TO=

# ── Free Evaluation form (functions/api/evaluation-request.js) ─────────────
# Same idea as above, but for the homepage "Free On-Site Evaluation" form,
# which replaced the old HubSpot embed. Uses Resend to send email instead
# of Quo/OpenPhone to send SMS.

# Resend API key — resend.com → API Keys. Mark as "Secret" in Cloudflare.
RESEND_API_KEY=

# Email address(es) that should receive a notification when the evaluation
# form is submitted. Comma-separate multiple addresses.
EVAL_ALERT_TO=brian@sidecarservices.com,support@sidecarservices.com,vala@sidecarservices.com

# The verified "from" address Resend sends as (must be on a domain you've
# verified with Resend, e.g. leads@sidecarservices.com). If unset, falls
# back to onboarding@resend.dev, which only delivers to your own Resend
# account email — fine for a quick test, not for production.
EVAL_FROM=
